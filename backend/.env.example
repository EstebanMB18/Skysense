ENV=local
DATABASE_URL=sqlite:///./skysense.db
JWT_SECRET=local-development-secret-change-before-production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
OTP_DELIVERY_MODE=console
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=skynode
MQTT_PASSWORD=local-mqtt-password
MQTT_TOPIC_ROOT=skysense
INGEST_API_KEY=local-ingest-key-change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
SEED_DEMO_USERS=true
