# ===== SkySense deployment =====
ENV=production

# PostgreSQL
POSTGRES_DB=skysense
POSTGRES_USER=skysense
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Application security - GENERATE UNIQUE VALUES before deploy
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARS
INGEST_API_KEY=CHANGE_ME_WITH_AT_LEAST_48_RANDOM_CHARS
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Redis / OTP
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
OTP_DELIVERY_MODE=console

# MQTT
MQTT_USERNAME=skynode
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD
MQTT_TOPIC_ROOT=skysense

# Frontend/API
CORS_ORIGINS=http://localhost:8080
SEED_DEMO_USERS=true

# AWS SES (use only when OTP_DELIVERY_MODE=ses)
AWS_REGION=us-east-1
SES_FROM_EMAIL=no-reply@example.com
